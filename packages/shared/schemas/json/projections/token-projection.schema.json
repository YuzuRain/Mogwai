{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "privacy_mode": {
      "type": "string",
      "enum": [
        "0",
        "1"
      ]
    },
    "blocked": {
      "type": "string",
      "enum": [
        "0",
        "1"
      ]
    },
    "rpm": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "tpm": {
      "type": "string",
      "pattern": "^\\d+$"
    }
  },
  "required": [
    "user_id",
    "privacy_mode",
    "blocked"
  ]
}
