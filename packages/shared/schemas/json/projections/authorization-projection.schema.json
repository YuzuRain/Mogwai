{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service_fee_owed_cp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pledge_available_cp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "debts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "creditor_user_id": {
            "type": "string",
            "minLength": 1
          },
          "amount_cp": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "incurred_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "creditor_user_id",
          "amount_cp",
          "incurred_at"
        ]
      }
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "amount_cp": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "incurred_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "debtor_user_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "amount_cp",
          "incurred_at",
          "debtor_user_id"
        ]
      }
    },
    "blocked": {
      "type": "boolean"
    }
  },
  "required": [
    "service_fee_owed_cp",
    "pledge_available_cp",
    "debts",
    "credits",
    "blocked"
  ]
}
